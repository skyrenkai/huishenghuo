# 本地开发时复制成 .env.local 再填；线上在 Vercel → Settings → Environment Variables 里填同样的变量
NEXT_PUBLIC_SUPABASE_URL=https://你的项目.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=https://huishenghuo.vercel.app

# 微信登录（开通后再填，并把下面这个改成 1）
NEXT_PUBLIC_WECHAT_ENABLED=
WECHAT_OPEN_APPID=
WECHAT_OPEN_SECRET=
WECHAT_MP_APPID=
WECHAT_MP_SECRET=
